# =========================================================================
# Example environment configuration for the ER Triage Queue App
# -------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values when enabling AWS. The
# file-only demo build runs WITHOUT any of these set (demo-mode fallbacks).
# NEVER commit a real .env with credentials.
# =========================================================================

# ---- General AWS ----
AWS_REGION=us-east-1
# AWS credentials should come from the environment / IAM role / SSO profile,
# NOT be written here. Keep all credentials server-side.

# ---- Amazon Lex (voice intake) ----
# Set LEX_ENABLED=true and provide bot identifiers to use live voice intake.
LEX_ENABLED=false
LEX_BOT_ID=
LEX_BOT_ALIAS_ID=

# ---- Amazon Bedrock (AI summaries / explanations) ----
# Set BEDROCK_ENABLED=true and ensure the model is accessible in your region.
BEDROCK_ENABLED=false
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# ---- Queue behavior ----
# Minutes before a long wait triggers a nurse notification.
WAIT_THRESHOLD_MINUTES=30
