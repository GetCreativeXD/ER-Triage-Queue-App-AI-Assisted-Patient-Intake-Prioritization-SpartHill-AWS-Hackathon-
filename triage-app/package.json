{
  "name": "er-triage-native-app",
  "version": "1.0.0",
  "private": true,
  "description": "Native (Capacitor) triage app for ER staff: shows a QR code that sends patients to the intake website, and a live priority queue with patient numbers and names.",
  "type": "module",
  "scripts": {
    "sync": "cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "run:android": "cap run android"
  },
  "dependencies": {
    "@capacitor/android": "6.1.2",
    "@capacitor/core": "6.1.2",
    "@capacitor/ios": "6.1.2"
  },
  "devDependencies": {
    "@capacitor/cli": "6.1.2"
  }
}
